{
  "name": "almsmanager",
  "productName": "AlmsManager",
  "version": "0.1.1",
  "description": "AlmsManager - alms requests for members and churches, their approval, the quarterly checks or invoice write-offs they need, and each year's review, with daily reminders sent by Power Automate",
  "author": "Anabaptist Brotherhood",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "preversion": "npm test",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "ab-common": "git+https://github.com/AB-Kevin/ab-common.git#v1.2.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.almsmanager",
    "productName": "AlmsManager",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "AlmsManager",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AlmsManager-Setup-${version}.${ext}"
    }
  }
}
